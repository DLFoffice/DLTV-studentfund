rules_version = '2';

// ============================================================
// Security Rules — DLTV Fund (v7 : จำกัดฟิลด์ที่นักเรียนแก้ได้)
// ------------------------------------------------------------
// v7 (เพิ่มจาก v6):
//  A. บัญชีนักเรียนแก้เอกสารตัวเองได้ "เฉพาะฟิลด์แบบฟอร์ม" (form1/form2/forms/sdq)
//     เดิมแก้ได้ทุกฟิลด์ยกเว้น no/id/name → แก้ประวัติเบิกจ่าย/GPA/เลขบัญชีได้
//     และฝังสคริปต์ในชื่อเล่น/URL รูปเพื่อโจมตีเบราว์เซอร์ของครูได้
//     ⚠️ ต้องใช้คู่กับ js/18-firebase-bridge.js v15 (ส่งเฉพาะฟิลด์เหล่านี้ในโหมดนักเรียน)
//  B. เจ้าของบัญชีแก้ accounts ของตัวเองได้เฉพาะ สถานะรหัสผ่าน / ลบรหัสเริ่มต้น / ผูก studentId
//  C. loginLogs ต้องเป็น log ของตัวเอง (uid ตรง) + เวลาจากเซิร์ฟเวอร์ + ฟิลด์จำกัด
//  D. roster เก็บเฉพาะ no + ค่าแฮชชื่อ (ห้ามมีชื่อจริง)
// ------------------------------------------------------------
// เปลี่ยนจาก v3/v5 อย่างมีนัยสำคัญ:
//  1. "ครู/เจ้าหน้าที่" ต้องถูกประกาศชัดเจน (admins/... หรือ accounts.role=='staff')
//     เดิมใช้ !isStudentAcct() แปลว่า "ใครที่ยังไม่มีเอกสาร accounts = ครู"
//     → ใครก็ตามที่สมัคร Firebase Auth ได้ จะอ่าน/เขียนข้อมูลเด็กครบ 72 คนทันที
//  2. บัญชีนักเรียนแก้ role / no / username / email / name ของตัวเองไม่ได้อีก
//     (เดิมแก้ role เป็นค่าอื่นแล้วเลื่อนขั้นตัวเองเป็นครูได้)
//  3. บัญชีนักเรียนผูก studentId เองได้ แต่ต้องเป็นเอกสารที่ "ลำดับ" ตรงกับบัญชีเท่านั้น
//  4. เพิ่ม roster (ทะเบียนสาธารณะ เก็บแค่ ลำดับ+ชื่อ) สำหรับหน้าสมัครสมาชิก
//     → register.html ไม่ต้องอ่าน collection students อีกต่อไป
//  5. เพิ่ม settings (ภาคเรียนที่เปิดให้กรอก)
//
// ติดตั้ง: Firebase Console → Firestore Database → Rules → วางทั้งหมด → Publish
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn()  { return request.auth != null; }
    function myUid()     { return request.auth.uid; }
    function acctPath()  { return /databases/$(database)/documents/accounts/$(myUid()); }
    function hasAcct()   { return signedIn() && exists(acctPath()); }
    function acct()      { return get(acctPath()).data; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    // ครู/เจ้าหน้าที่ = แอดมิน หรือบัญชีที่ "แอดมินตั้ง role = staff ให้" เท่านั้น
    function isStaff()   { return isAdmin() || (hasAcct() && acct().role == 'staff'); }
    function isStudent() { return hasAcct() && acct().role == 'student'; }

    // ฟิลด์ที่เจ้าของบัญชีห้ามแก้เอง (แอดมินแก้ได้)
    function keepsLockedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'no', 'username', 'email', 'name']) == false;
    }
    // ฟิลด์ในเอกสารนักเรียนที่ "บัญชีนักเรียน" แก้ได้ (ต้องตรงกับ STUDENT_WRITABLE_FIELDS ใน 18-firebase-bridge.js)
    function studentWritableOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['form1', 'form2', 'forms', 'sdq']);
    }
    // ผูก studentId ได้เฉพาะเอกสารที่ "ลำดับ" ตรงกับบัญชีตัวเอง
    function studentDocMatchesMyNo(sid) {
      return exists(/databases/$(database)/documents/students/$(sid))
        && get(/databases/$(database)/documents/students/$(sid)).data.no == resource.data.no;
    }

    /* ---------- students : ข้อมูลอ่อนไหว (เลขบัตร ปชช. / บัญชีธนาคาร) ---------- */
    match /students/{studentId} {
      // ครู/แอดมิน อ่านได้ทั้งหมด
      // นักเรียน อ่านได้เฉพาะเอกสารตัวเอง + เอกสารที่ "ลำดับ" ตรงกับบัญชี (ใช้ตอนผูกบัญชี)
      allow read: if isStaff()
        || (isStudent() && (acct().studentId == studentId || resource.data.no == acct().no));

      allow create, delete: if isStaff();

      // นักเรียนแก้ได้เฉพาะเอกสารตัวเอง และเฉพาะฟิลด์แบบฟอร์ม (v7)
      allow update: if isStaff()
        || (isStudent()
            && acct().studentId == studentId
            && studentWritableOnly());
    }

    /* ---------- roster : ทะเบียนสาธารณะสำหรับหน้าสมัคร (ลำดับ + ชื่อ เท่านั้น) ---------- */
    // v7: เก็บเฉพาะ no + ค่าแฮชของชื่อ — ห้ามมีชื่อจริง/โรงเรียน/ข้อมูลอ่อนไหวเด็ดขาด
    match /roster/{noKey} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['no', 'nameHash', 'surnameHash']);
      allow delete: if isStaff();
    }

    /* ---------- settings : ภาคเรียนที่เปิดให้กรอก ---------- */
    match /settings/{key} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    /* ---------- usernames : ตารางแปลง username -> email (เขียนได้เฉพาะผู้ดูแล) ---------- */
    match /usernames/{username} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    /* ---------- registered : กันสมัครซ้ำ 1 ลำดับ = 1 บัญชี (เขียนได้เฉพาะผู้ดูแล) ---------- */
    match /registered/{noKey} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    /* ---------- accounts : ระเบียนบัญชีผู้ใช้ ---------- */
    match /accounts/{uid} {
      allow read: if isAdmin() || (signedIn() && myUid() == uid);

      // ปิดการสมัครเอง — สร้างบัญชีนักเรียนได้เฉพาะผู้ดูแล/ครู (หน้า accounts.html)
      allow create: if isStaff();

      // เจ้าของบัญชีแก้ได้: สถานะรหัสผ่าน / ลบรหัสเริ่มต้น และ "ผูก studentId" ที่ลำดับตรงกันเท่านั้น
      allow update: if isStaff()
        || (signedIn() && myUid() == uid
            && keepsLockedFields()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['mustChangePassword', 'passwordChangedAt', 'initialPassword', 'studentId'])
            // ปิด "บังคับเปลี่ยนรหัส" ได้ แต่เปิดกลับเองไม่ได้ / ลบรหัสเริ่มต้นได้ แต่ใส่ค่าใหม่ไม่ได้
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mustChangePassword'])
                || request.resource.data.mustChangePassword == false)
            && !('initialPassword' in request.resource.data
                 && request.resource.data.initialPassword != resource.data.get('initialPassword', null))
            && (request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
                || studentDocMatchesMyNo(request.resource.data.studentId)));

      allow delete: if isAdmin();
    }

    /* ---------- loginLogs : เขียนอย่างเดียว อ่านเฉพาะครู/แอดมิน ---------- */
    match /loginLogs/{logId} {
      // v7: บันทึกได้เฉพาะ log ของตัวเอง เวลาต้องมาจากเซิร์ฟเวอร์ และฟิลด์จำกัด
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'username', 'name', 'at', 'ua'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.get('ua', '') is string
        && request.resource.data.get('ua', '').size() <= 200;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    /* ---------- codeRequests : ครูขอรับรหัสนักเรียนทุน ----------
       ครู (ยังไม่ล็อกอิน) ส่งคำขอ "ขอรหัสของนักเรียนลำดับ N" ได้
       → status ต้องเป็น 'pending' และจำกัดฟิลด์/ความยาว/รูปแบบอีเมล กันสแปม
       อ่าน/อนุมัติ/ลบ ได้เฉพาะครู-แอดมิน (หน้า accounts.html)
       การตรวจว่าลำดับ+ชื่อตรงทะเบียนจริง ทำที่ฝั่งผู้ดูแลตอนอนุมัติ */
    match /codeRequests/{reqId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['no','studentName','school','teacherName','position','email','note','status','createdAt'])
        && request.resource.data.no is number
        && request.resource.data.no >= 1 && request.resource.data.no <= 100000
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 1 && request.resource.data.studentName.size() <= 120
        && request.resource.data.school is string && request.resource.data.school.size() <= 200
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() >= 2 && request.resource.data.teacherName.size() <= 120
        && request.resource.data.position is string && request.resource.data.position.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('[^@\\s]+@[^@\\s]+[.][^@\\s]+')
        && request.resource.data.email.size() <= 200;
      allow read, list: if isStaff();
      allow update, delete: if isStaff();
    }

    /* ---------- admins : เพิ่มผ่าน Firebase Console เท่านั้น ---------- */
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
